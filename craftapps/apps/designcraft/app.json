  "port": {"default": 12347, "env": "DESIGNCRAFT_CONTROL_PORT"},
  "profile_env": "DESIGNCRAFT_CONFIG_DIR",
  "auth": {"kind": "none"},
  "menu_key": "command",
  "render": {"method": "ui.render", "artboard_key": "page"},
