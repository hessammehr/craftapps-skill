{
  "id": "photocraft", "name": "PhotoCraft", "kind": "raster photo editor (Photoshop-style)",
  "binary": {"darwin": "/Applications/PhotoCraft.app/Contents/MacOS/PhotoCraft", "linux": "photocraft", "win32": "%LOCALAPPDATA%/Programs/ArtCraft/PhotoCraft/photocraft.exe"},
  "cli": {"darwin": "/Applications/PhotoCraft.app/Contents/MacOS/photocraft-cli", "linux": "photocraft-cli", "win32": "%LOCALAPPDATA%/Programs/ArtCraft/PhotoCraft/photocraft-cli.exe"},
  "port": {"default": 12346, "env": "PHOTOCRAFT_CONTROL_PORT"},
  "profile_env": "PHOTOCRAFT_CONFIG_DIR",
  "auth": {"kind": "auth_request", "token_file_flag": "--control-token-file"},
  "roots": {"read_flag": "--automation-read-root", "write_flag": "--automation-write-root", "required": true},
  "menu_key": "id",
  "screenshot_params": {"focus": false},
  "docs": ["https://raw.githubusercontent.com/storytold/photocraft/main/docs/control-protocol.md", "https://raw.githubusercontent.com/storytold/photocraft/main/docs/mcp.md"]
}
